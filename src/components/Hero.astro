---
// BASE_URL puede venir con o sin barra final según el entorno; la normalizamos.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section class="hero">
  <h1 class="display-lg hero__title">Imágenes que permanecen</h1>
  <p class="lede hero__lede">
    Fotografía y cine para marcas que quieren sentirse, no solo verse.
  </p>
  <div class="hero__actions">
    <a class="btn" href={`${base}fotos/`} data-astro-prefetch="hover">Ver fotografía</a>
    <a class="btn btn--ghost" href={`${base}videos/`} data-astro-prefetch="hover">Ver video</a>
  </div>
  <span class="hero__scroll" aria-hidden="true">Explorar</span>
</section>
